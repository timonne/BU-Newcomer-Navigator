# ─────────────────────────────────────────────────────────────────────────
# Newcomer Navigation backend — environment configuration
# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit your real `.env` file — it is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────
# Default: local SQLite file, zero setup required for development.
#   DATABASE_URL=sqlite:///./data/app.db
# To use PostgreSQL instead, set something like:
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/newcomer_navigation
# and uncomment psycopg2-binary in requirements.txt.
DATABASE_URL=sqlite:///./data/app.db

# ── Auth / JWT ──────────────────────────────────────────────────────────
# Secret used to sign JWTs. MUST be a long, random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Name of the httpOnly cookie the backend sets on login/register.
AUTH_COOKIE_NAME=nn_access_token
# Set to "true" behind HTTPS in production so the cookie is Secure.
COOKIE_SECURE=false

# ── University email verification ──────────────────────────────────────
# Comma-separated list of email domains allowed for Student / Staff signup
# verification. These are NOT filled in with a real Bennett University
# domain because it has not been verified for this project — set it here
# once you have the official domain(s).
#   Example (DO NOT assume this is correct — confirm officially first):
#   STUDENT_EMAIL_DOMAINS=bennett.edu.in
#   STAFF_EMAIL_DOMAINS=bennett.edu.in
STUDENT_EMAIL_DOMAINS=
STAFF_EMAIL_DOMAINS=

# ── Email delivery (for verification codes / password reset) ───────────
# If left blank, the backend runs in "console mode": verification codes
# and reset links are printed to the backend log instead of emailed.
# This is fine for local development but MUST be configured for any real
# deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_USE_TLS=true

# ── AI provider (chatbot fallback layer) ────────────────────────────────
# Optional. If AI_API_KEY is left blank, the chatbot still works using the
# university knowledge base -> forum retrieval -> deterministic fallback
# chain — it just skips the AI-generated fallback step.
# AI_PROVIDER currently supports: "openai", "anthropic", or "" (disabled).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ── CORS / local hosting ────────────────────────────────────────────────
# The Figma Make dev server defaults to port 8443 (see figma uiux/vite.config.ts
# and .figma/make/dev.json) rather than Vite's usual 5173 — confirm the
# actual port your frontend is running on and update this if different.
FRONTEND_URL=http://localhost:8443
BACKEND_URL=http://localhost:8000

# ── Misc ────────────────────────────────────────────────────────────────
# "development" enables the interactive /docs page and verbose errors.
ENVIRONMENT=development
LOG_LEVEL=INFO